# Variables d'environnement (développement). Copier en .env.
# Production : voir deploy/production.env.example.

NODE_ENV=development

# MariaDB local (npm run db:start) : port 33306.
# Production : préférer DB_HOST, DB_PORT, DB_NAME, DB_USER et DB_PASSWORD.
DATABASE_URL=mysql://expospace:expospace-local-only@127.0.0.1:33306/expospace
# Base des tests, distincte de la base de développement.
DATABASE_URL_TEST=mysql://expospace:expospace-local-only@127.0.0.1:33306/expospace_test
# Base fantôme de npm run db:migrate.
SHADOW_DATABASE_URL=mysql://expospace:expospace-local-only@127.0.0.1:33306/expospace_shadow

# Secret du cookie de session (32 caractères minimum). Absent : généré dans DATA_DIR.
# SESSION_SECRET=

# Serveur de l'API en développement.
HOST=127.0.0.1
PORT=3000

# Origine publique, contrôlée sur les requêtes d'écriture.
# Production : https://expospace.by-h.me
PUBLIC_ORIGIN=http://localhost:5173

# Données (images, sauvegardes, secret). Production : ../expospace-data
# DATA_DIR=.local
# Surcharges possibles : UPLOAD_DIR, TMP_DIR, BACKUP_DIR, MAINTENANCE_FILE.

# Plafond total des images, en Mo (facultatif).
# MAX_TOTAL_STORAGE_MB=

# Proxys de confiance (production : loopback, linklocal, uniquelocal).
TRUST_PROXY=0

# off : désactive la limitation des tentatives (local uniquement).
RATE_LIMITS=on

# Mot de passe des comptes de démonstration (npm run db:seed).
SEED_PASSWORD=
