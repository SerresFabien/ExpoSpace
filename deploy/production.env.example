# Copier en .env dans le dossier de l'application.
# Ne jamais versionner le fichier rempli.
NODE_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nom_exact_de_la_base
DB_USER=nom_exact_de_l_utilisateur
DB_PASSWORD=mot_de_passe_de_l_utilisateur
DATA_DIR=../expospace-data
PUBLIC_ORIGIN=https://expospace.by-h.me
MAX_TOTAL_STORAGE_MB=900
